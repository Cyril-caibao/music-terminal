<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 录音（边听边录） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 读取音频文件：Android 13+ 用细分权限，旧版用外部存储读权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 播放服务/通知：不涉及任何联网能力 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 后台放歌不被省电策略降频/冻结：需要在设置里把本应用加进「忽略电池优化」白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 9 及以下直接写文件需要；10+ 走 MediaStore 写请求 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 底线：不允许任何联网能力。依赖（WorkManager）会合并进来 ACCESS_NETWORK_STATE，
         这里显式移除；INTERNET 从不声明。 -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".player.CyrilApp"
        android:largeHeap="true"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CyrilMusic"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CyrilMusic"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 文件管理器「打开方式」→ 播放。和下面的「编辑标签」成一对，
                 两个条目的名字取自各自的 android:label。 -->
            <intent-filter android:label="CyrilMusic 播放">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
                <data android:scheme="content" android:mimeType="application/ogg" />
                <data android:scheme="file" android:mimeType="application/ogg" />
            </intent-filter>
            <!-- 有些文件管理器发的是不带 MIME 的 file:// → 按扩展名兜一层 -->
            <intent-filter android:label="CyrilMusic 播放">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mp3" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.flac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wav" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4a" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ogg" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.opus" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ape" />
            </intent-filter>
        </activity>

        <!-- 打开方式 → 编辑标签 -->
        <activity
            android:name=".TagEditActivity"
            android:exported="true"
            android:label="CyrilMusic 编辑标签"
            android:theme="@style/Theme.CyrilMusic"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter android:label="CyrilMusic 编辑标签">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
                <data android:scheme="content" android:mimeType="application/ogg" />
                <data android:scheme="file" android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter android:label="CyrilMusic 编辑标签">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mp3" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.flac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wav" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4a" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ogg" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.opus" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ape" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
